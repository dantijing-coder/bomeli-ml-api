# Database Connection (Hostinger Remote MySQL or Cloud Database)
DB_HOST=your-hostinger-mysql-server.com
DB_USER=u123456789_bomeli
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=u123456789_bomeli_db
DB_PORT=3306

# API Security Key (Set a random string to secure your endpoints from unauthorized access)
ML_API_KEY=bomeli_sec_9948a73b4e0192df8c21

# Web Server Port (Defaults to 7860 on Hugging Face Spaces, or set automatically by Render)
PORT=7860
